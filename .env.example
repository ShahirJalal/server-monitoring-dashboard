# Copy to .env (git-ignored) and fill in real values before deploying anywhere
# beyond a local sandbox. docker-compose.yml reads these automatically.

# Login for create/update/delete on the dashboard. The compose defaults
# (admin/admin123) are fine for a first local run but must be overridden
# before this is exposed on the internet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Comma-separated origins allowed to call the API directly. Not needed in
# prod, where Nginx proxies /api same-origin -- only matters if something
# calls the backend's port directly. Include your real public domain if you
# ever see 403s on login/writes that trace back to CORS -- see DEPLOYMENT.md.
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://dashboard.shahirjalal.com

# ntfy.sh topic for status-change push notifications. Leave blank to disable.
# Pick something private -- anyone who knows the topic name can read your
# alerts (or publish fake ones). A random slug is fine, e.g.:
#   NTFY_TOPIC=shahir-smd-7f2a9c
# Then subscribe to that same topic in the ntfy app/website.
NTFY_TOPIC=
