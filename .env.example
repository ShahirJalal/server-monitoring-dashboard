# Copy to .env (git-ignored) and fill in real values before deploying anywhere
# beyond a local sandbox. docker-compose.yml reads these automatically.

# Login for create/update/delete on the dashboard. The compose defaults
# (admin/admin123) are fine for a first local run but must be overridden
# before this is exposed on the internet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Comma-separated origins allowed to call the API directly. Not needed in
# prod, where Nginx proxies /api same-origin -- only matters if something
# calls the backend's port directly.
CORS_ALLOWED_ORIGINS=http://localhost:4200
